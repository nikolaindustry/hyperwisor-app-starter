# Copy this file to .env.local and fill in your real values.
# .env.local is git-ignored — your keys never get committed.
#
# Leave these unset (or delete .env.local) to run the app in MOCK MODE.

# Hyperwisor manufacturer API key (starts with mk_)
VITE_HW_API_KEY=

# Hyperwisor manufacturer secret key (starts with msk_)
# WARNING: do not ship this in production mobile builds. See docs/SECURITY.md.
VITE_HW_SECRET_KEY=

# Optional overrides — defaults are fine for the standard Hyperwisor backend.
# Only set these if you are self-hosting.
#
# VITE_HW_RELAY_HOST is a HOSTNAME, not a URL: no scheme, no trailing slash.
# The app builds wss://<host>/?id=… itself.
#
# Do not point the relay somewhere else to "test" something. A WebSocket that
# never opens is indistinguishable from a device that is merely offline, so a
# wrong host here fails silently — no error, no log, nothing ever responds.
#
# VITE_HW_API_BASE_URL=https://hyperwisor.nikolaindustry.workers.dev/functions/v1
# VITE_HW_RELAY_HOST=hyperwisor-realtime-secure.onrender.com

# Optional: required only when app.config.ts mode is "single-product"
# VITE_HW_PRODUCT_ID=

# --- Agent generation (npm run generate <productId>) -----------------
# Required ONLY if you'll use `npm run generate` to have an AI agent
# build a product's UI for you. Get a key at https://console.anthropic.com.
# ANTHROPIC_API_KEY=
